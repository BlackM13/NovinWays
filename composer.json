{
    "name": "BlackM13/novinways",
    "description": "Laravel package for Novinways SOAP services",
    "keywords": [
        "laravel",
        "soap",
        "novinways",
        "iran"
    ],
    "type": "library",
    "license": "MIT",

    "require": {
        "php": "^8.0",
        "ext-soap": "*",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },

    "autoload": {
        "psr-4": {
            "BlackM13\\Novinways\\": "src/"
        }
    },

    "extra": {
        "laravel": {
            "providers": [
                "BlackM13\\Novinways\\NovinwaysServiceProvider"
            ],
            "aliases": {
                "Novinways": "BlackM13\\Novinways\\Facades\\Novinways"
            }
        }
    },

    "minimum-stability": "stable",
    "prefer-stable": true
}